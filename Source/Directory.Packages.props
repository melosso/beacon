<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <EfCoreVersion>11.0.0</EfCoreVersion>
    <SerilogSinksVersion>10.0.0</SerilogSinksVersion>
    <TestcontainersVersion>4.16.0</TestcontainersVersion>
  </PropertyGroup>

  <ItemGroup Label="App">
    <!-- Pinned, not floating: a floating version made every build non-reproducible. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="$(SerilogSinksVersion)" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <!-- No 11.0.0 GA published; deliberately not on $(EfCoreVersion). -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="11.0.0-preview" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
  </ItemGroup>

  <ItemGroup Label="Security pins">
    <!-- Transitive 2.0.0 carries GHSA-v5pm-xwqc-g5wc (high). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <!-- Transitive 2.1.11 carries GHSA-2m69-gcr7-jv3q (high). -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Transitive 9.0.4 (via SqlClient) carries GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(EfCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Testcontainers.MsSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.MySql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Transitive 2025.1.0 (via Testcontainers) carries GHSA-mggc-4xg6-vcxf and GHSA-q939-rpr3-3284 (high). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
