{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Serilog.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/beacon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Beacon": {
    "TokenExpiryDays": 30,
    "DatabaseProvider": "sqlite",

    "___comment_encryption___": "The following keys should be changed to secure values in production and will be encrypted immediately upon first run.",
    "ConnectionString": "BENC:::ibVNyED/SJPmCFfcqJsIzooiZlfBQr/oquRK7GW7z/M=",
    "SigningKey": "BENC:::AodktVy7qBQXcS238F+Jx5aIDDycpi9B6YiYhkTMEPY=",
    "EncryptionKey": "BENC:::c25vHZpxKV5GCTb+w928jSrgypGufhETRRlapZ8HIDI=",
    "Pepper": "BENC:::63SwGUW6NPLXsCxRkTce6WfHOyww9N9f6TMzHgN/mK0=",
    "AdminApiKey": "BENC:::zNuWM3+8emuKn+l4jIQsYuEoYxWI56llkTEVNVnzNH4=",

    "___comment_routing___": "Host-based routing (leave empty for port-based mode)",
    "ApiHosts": "",
    "AdminHosts": "",
    "AllowedOrigins": "",

    "___comment_ports___": "Port-based routing (used when ApiHosts/AdminHosts are empty)",
    "ApiPort": 5000,
    "AdminPort": 5001,

    "___comment_proxy___": "Enable when behind a reverse proxy (nginx, traefik, etc.)",
    "TrustForwardedHeaders": false
  }
}
