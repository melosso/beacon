{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Serilog.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/beacon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Beacon": {
    "TokenExpiryDays": 30,
    "DatabaseProvider": "sqlite",

    "___comment_encryption___": "The following keys should be changed to secure values in production and will be encrypted immediately upon first run.",
    "ConnectionString": "BENC:::iU+jGJr5Ykk/y5hm2yM6+tWz6vI5WUs2SOzJYnnYrc4=",
    "SigningKey": "BENC:::dwn3QXx/xZ7aIC3xvb1VGoMI10Ve6g1lZ0EE0rVjJc8=",
    "EncryptionKey": "BENC:::hvPMkRm6TquKsNKMXJvyrKI6PaHoGFRv+zj8ehPmqU4=",
    "Pepper": "BENC:::etqs3MtHIZmtrtJYSCUdIjhEBJccREsvH18ALixRlgo=",
    "AdminApiKey": "BENC:::GYDoBI4YcBLQJs/+ta+TPd/JisIRUPXD136aVh/ZdPc=",

    "___comment_routing___": "Host-based routing (leave empty for port-based mode)",
    "ApiHosts": "",
    "AdminHosts": "",
    "AllowedOrigins": "",

    "___comment_ports___": "Port-based routing (used when ApiHosts/AdminHosts are empty)",
    "ApiPort": 5000,
    "AdminPort": 5001,

    "___comment_proxy___": "Enable when behind a reverse proxy (nginx, traefik, etc.)",
    "TrustForwardedHeaders": false
  }
}
