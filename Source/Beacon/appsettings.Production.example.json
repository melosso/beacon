{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Serilog.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/beacon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "beacon-api.example.com;beacon-admin.example.com",
  "Beacon": {
    "TokenExpiryDays": 7,
    "DatabaseProvider": "sqlite",

    "___comment_encryption___": "Generate secure random values for production. These will be encrypted on first run.",
    "ConnectionString": "Data Source=Beacon.db",
    "SigningKey": "your-secure-signing-key-here",
    "EncryptionKey": "your-secure-encryption-key-here",
    "Pepper": "your-secure-pepper-here",
    "AdminApiKey": "your-secure-api-key-here",

    "___comment_routing___": "Host-based routing (leave empty for port-based mode)",
    "ApiHosts": "beacon-api.example.com",
    "AdminHosts": "beacon-admin.example.com",
    "AllowedOrigins": "https://app.example.com,https://dashboard.example.com",

    "___comment_ports___": "Port-based routing (used when ApiHosts/AdminHosts are empty)",
    "ApiPort": 5000,
    "AdminPort": 5001,

    "___comment_proxy___": "Enable when behind a reverse proxy (nginx, traefik, etc.)",
    "TrustForwardedHeaders": true
  }
}
