{
  "Beacon": {
    "DatabaseProvider": "sqlite",
    "ConnectionString": "Data Source=Beacon.db",
    "SigningKey": "your-secure-signing-key-here",
    "EncryptionKey": "your-secure-encryption-key-here",
    "Pepper": "your-secure-pepper-here",
    "AdminApiKey": "your-secure-api-key-here",
    "TokenExpiryDays": 7,
    "ApiPort": 5000,
    "AdminPort": 5001,
    "PublicUrl": "https://beacon-api.example.com",
    "ApiHosts": "beacon-api.example.com",
    "AdminHosts": "beacon-admin.example.com",
    "AllowedOrigins": "https://app.example.com,https://dashboard.example.com",
    "TrustForwardedHeaders": true,
    "EnforceHttps": false,
    "DisableEmailNotifications": false
  },
  "AllowedHosts": "beacon-api.example.com;beacon-admin.example.com",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Serilog.AspNetCore": "Warning",
        "Beacon.Security.ApiKeyAuthHandler": "Warning",
        "Beacon.Security.JwtAuthHandler": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/beacon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ]
  }
}