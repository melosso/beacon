{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Beacon": {
    "DatabaseProvider": "sqlite",
    "ConnectionString": "Data Source=Beacon.db",
    "TokenExpiryDays": 30,
    "SigningKey": "INSECURE-CHANGE-ME-signing-key",
    "EncryptionKey": "INSECURE-CHANGE-ME-encrypt-key",
    "Pepper": "INSECURE-CHANGE-ME-pepper",
    "AdminApiKey": "INSECURE-CHANGE-ME-api-key"
  }
}
