{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Beacon": {
    "DatabaseProvider": "sqlite",
    "ConnectionString": "Data Source=Beacon.db",
    "TokenExpiryDays": 30,
    "SigningKey": "INSECURE-CHANGE-ME-signing-key",
    "EncryptionKey": "INSECURE-CHANGE-ME-encrypt-key",
    "Pepper": "INSECURE-CHANGE-ME-pepper",
    "AdminApiKey": "INSECURE-CHANGE-ME-api-key",

    "_comment_routing": "Host-based routing (leave empty for port-based mode)",
    "ApiHosts": "",
    "AdminHosts": "",
    "AllowedOrigins": "",

    "_comment_ports": "Port-based routing (used when ApiHosts/AdminHosts are empty)",
    "ApiPort": 5000,
    "AdminPort": 5001,

    "_comment_proxy": "Enable when behind a reverse proxy (nginx, traefik, etc.)",
    "TrustForwardedHeaders": false
  }
}
